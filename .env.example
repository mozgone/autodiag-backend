# ============================================================
# Sellex — файл настроек
# Скопируйте этот файл: cp .env.example .env
# И заполните нужные значения
# ============================================================

# --- Безопасность ---
# Обязательно смените на случайную строку в продакшене!
SECRET_KEY=sellex-super-secret-key-change-in-production

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://sellex:sellex123@localhost:5432/sellex
DATABASE_URL_SYNC=postgresql://sellex:sellex123@localhost:5432/sellex

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- ИИ (необязательно) ---
# Если не задан — система использует шаблонные рекомендации (бесплатно)
# Получить ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Telegram Bot ---
# Токен бота (получить у @BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Username бота без @ (заполняется после запуска setup_bot.py)
TELEGRAM_BOT_USERNAME=
# URL вашего приложения на Railway (https://yourapp.up.railway.app)
APP_URL=
# Полный URL Mini App (обычно APP_URL + /tg)
MINI_APP_URL=

# --- amoCRM (необязательно) ---
# Заполнять только если подключаете реальную amoCRM
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
